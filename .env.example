# Chronos Environment Configuration Example

# Search Provider API Keys (Any one of the following; if omitted, Chronos uses autonomous fallback search)
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# LLM Provider API Keys (Any one of the following)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Runtime Settings
PORT=3000
DATABASE_PATH=./data/chronos.db
